# Docker 部署配置（复制为 .env）
# 应用镜像只从本仓库源码构建（docker compose build），不从任何 registry 拉取；
# ARTEX_TAG 是构建出来的本地镜像 tag。
ARTEX_TAG=local
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
