# syntax=docker/dockerfile:1
#
# 从源码构建 ARTEX 运行镜像（docker compose 默认走这条路）。
#
# 与仓库根目录的 Dockerfile 的分工：
#   - 根 Dockerfile 供 CI 发布使用：假定二进制已由 CI 编译好放在 dist/<arch>/artex，
#     镜像里只装运行环境，多平台构建更快。
#   - 本文件自包含：在镜像内完成「前端静态导出 → Go 编译（内嵌前端）→ 运行环境」，
#     不依赖任何预编译产物，也不需要从任何第三方 registry 拉取应用镜像。

# ── ① 前端静态导出（Next.js）──────────────────────────────
FROM node:22-bookworm-slim AS web
WORKDIR /src/web
# 先只拷依赖清单，让 npm ci 这层能被缓存复用
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
ENV NEXT_EXPORT=1
RUN npm run build:static

# ── ② Go 编译：静态单二进制，内嵌前端 ─────────────────────
FROM golang:1.26-bookworm AS build
ARG TARGETARCH
ARG ARTEX_VERSION=docker
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# 内嵌目录由前端阶段产物填充（-tags embedui 依赖它存在）
COPY --from=web /src/web/out ./server/webui/dist
RUN CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH:-amd64}" \
      go build -tags embedui -trimpath \
      -ldflags "-s -w -X main.version=${ARTEX_VERSION}" \
      -o /out/artex ./cmd/artex

# ── ③ 运行镜像：与根 Dockerfile 保持同一套运行环境 ─────────
FROM python:3.12-slim-bookworm
# 常用工具：ripgrep / curl / vim，加一批 recon 常备件（按需增删）。
# Node 从 NodeSource 装 20.x：bookworm 自带的 apt nodejs 是 18，Playwright 要求 >=20。
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates ripgrep curl wget vim git jq unzip \
      dnsutils iputils-ping netcat-openbsd inetutils-telnet whois nmap \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*
# 预装 Playwright MCP 与 CLI（全局），运行时不再联网下载。
RUN npm install -g @playwright/mcp@latest @playwright/cli@latest playwright@latest \
    && playwright-cli --help \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
# 由上面 build 阶段编译出的二进制（已在镜像内完成编译，无需宿主预编译）
COPY --from=build /out/artex /app/artex
# 守护启动脚本：进程退出后按退出码决定是否重新拉起（崩溃自愈）。
COPY start.sh /app/start.sh
RUN chmod +x /app/artex /app/start.sh
COPY skills/ /app/skills/
# data/（SQLite + jwt.key）持久化点
VOLUME ["/app/data"]
EXPOSE 8787 8788
ENTRYPOINT ["/app/start.sh"]
CMD ["-addr", ":8787", "-proxy", ":8788"]
